<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Send student routes through the main LavaLust front controller.
    RewriteRule ^student/profile/?$ public/index.php/student/profile [END]
    RewriteRule ^student/?$ public/index.php/student [END]

    # Keep other requests inside the public document root.
    RewriteRule ^public(?:/|$) - [L]
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>